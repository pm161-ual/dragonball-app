{
    "openapi": "3.0.0",
    "info": {
        "title": "Dragon Ball API",
        "description": "API para la aplicación de Dragon Ball",
        "version": "1.0.0"
    },
    "paths": {
        "/api/planets": {
            "get": {
                "tags": [
                    "Planetas"
                ],
                "summary": "Listar planetas",
                "operationId": "25cb46e57e95546cf011c085d88b3c1c",
                "parameters": [
                    {
                        "name": "name",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "is_destroyed",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "boolean"
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Lista paginada de planetas"
                    }
                }
            },
            "post": {
                "tags": [
                    "Planetas"
                ],
                "summary": "Crear un planeta",
                "operationId": "f4277ef1bde595fc0ff27854748d3c7c",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "is_destroyed"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Vegeta"
                                    },
                                    "is_destroyed": {
                                        "type": "boolean",
                                        "example": true
                                    },
                                    "description": {
                                        "type": "string",
                                        "example": "Planeta natal de los Saiyans"
                                    },
                                    "image": {
                                        "type": "string",
                                        "example": "https://dragonball-api.com/planetas/Namek_U7.webp"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Planeta creado"
                    },
                    "401": {
                        "description": "No autenticado"
                    },
                    "422": {
                        "description": "Datos no válidos"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/planets/{planet}": {
            "get": {
                "tags": [
                    "Planetas"
                ],
                "summary": "Ver un planeta",
                "operationId": "295f8280f7da765241d177cb06d25682",
                "parameters": [
                    {
                        "name": "planet",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Planeta encontrado"
                    },
                    "404": {
                        "description": "Planeta no encontrado"
                    }
                }
            },
            "put": {
                "tags": [
                    "Planetas"
                ],
                "summary": "Actualizar un planeta",
                "operationId": "65e4f2456d4a00f6467cb241fc37e5ce",
                "parameters": [
                    {
                        "name": "planet",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Vegeta"
                                    },
                                    "is_destroyed": {
                                        "type": "boolean",
                                        "example": true
                                    },
                                    "description": {
                                        "type": "string",
                                        "example": "Planeta natal de los Saiyans"
                                    },
                                    "image": {
                                        "type": "string",
                                        "example": "https://dragonball-api.com/planetas/Namek_U7.webp"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Planeta actualizado"
                    },
                    "401": {
                        "description": "No autenticado"
                    },
                    "404": {
                        "description": "Planeta no encontrado"
                    },
                    "422": {
                        "description": "Datos no válidos"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "delete": {
                "tags": [
                    "Planetas"
                ],
                "summary": "Eliminar planeta",
                "operationId": "007ba98d278cf1110e6fc9d599f8c020",
                "parameters": [
                    {
                        "name": "planet",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Planeta eliminado"
                    },
                    "401": {
                        "description": "No autenticado"
                    },
                    "404": {
                        "description": "Planeta no encontrado"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        }
    },
    "components": {
        "securitySchemes": {
            "sanctum": {
                "type": "http",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Planetas",
            "description": "Planetas"
        }
    ]
}